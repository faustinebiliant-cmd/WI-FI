#!/usr/bin/env bash
# ============================================================
# Oswagolink - 2 GB swap: a safety net for when memory runs full (phase 7)
# Without swap, a full memory (for example "npm run build" on the VPS while
# customers are busy) makes Linux kill a program: possibly PostgreSQL or the backend.
# With swap, the VPS slows down for a moment instead.
# Run once:  sudo bash vps/wifi-add-swap
# Check:     swapon --show      (shows /swapfile, 2G)
# Undo:      sudo swapoff /swapfile && sudo rm /swapfile  and remove the /swapfile line in /etc/fstab
# ============================================================
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "Run it with sudo: sudo bash vps/wifi-add-swap" >&2
    exit 1
fi

if [ -n "$(swapon --show --noheadings)" ]; then
    echo "Swap is already on, nothing changed:"
    swapon --show
    exit 0
fi

if [ -e /swapfile ]; then
    echo "/swapfile exists but is not in use. Send this to Claude, nothing changed." >&2
    exit 1
fi

fallocate -l 2G /swapfile
chmod 600 /swapfile
mkswap /swapfile >/dev/null
swapon /swapfile

# Switched on again after every reboot
grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab

# Use swap only when memory is really full (Linux default 60 swaps much earlier)
echo 'vm.swappiness=10' > /etc/sysctl.d/99-wifi-swap.conf
sysctl -q -p /etc/sysctl.d/99-wifi-swap.conf

echo "Swap is on:"
swapon --show
