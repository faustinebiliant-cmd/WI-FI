# Oswagolink - nightly database backup (see vps/wifi-db-backup)
# Install: sudo install -o root -g root -m 644 vps/wifi-db-backup.cron /etc/cron.d/wifi-db-backup
# Runs at 00:00 VPS time; on a UTC server that is 03:00 in Tanzania (EAT).
# wifi_app = the DB_NAME in the backend .env on the VPS (change it here if that ever changes).
# The history clean-up runs an hour earlier (02:00 EAT), so the backup is already smaller.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 0 * * * root /usr/local/sbin/wifi-db-backup wifi_app
